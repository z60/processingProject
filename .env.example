# 复制为 .env 后填写。不要把真实凭据提交到仓库。
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

MYSQL_HOST=<mysql-host>
MYSQL_PORT=3306
MYSQL_USER=<mysql-user>
MYSQL_PASSWORD=<mysql-password>
MYSQL_DB=project1028
MYSQL_CONNECT_TIMEOUT=4

QDRANT_URL=http://<qdrant-host>:6333
QDRANT_COLLECTION=knowledge_chunks
QDRANT_DIM=1024
QDRANT_TIMEOUT=30

EMBEDDING_BASE_URL=http://<embedding-host>:8081/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH=16
EMBEDDING_TIMEOUT=60

# 留空 → 走离线脚本模型（offline demo / 回归）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0
LLM_TIMEOUT=60
